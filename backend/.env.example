# Application Configuration
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_SECRET_KEY=change-this-to-a-secure-jwt-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=chatbot_rag

# OpenRouter LLM Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Dedicated Embedding Provider Configuration
# Supported providers: "openrouter", "openai", "local_mock" (for offline tests/dev)
EMBEDDING_PROVIDER=openrouter
EMBEDDING_API_KEY=your_openrouter_api_key_here
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=text-embedding-3-small

# Vector Store Configuration
# Supported: "local" (persistent numpy cosine store) or "atlas" (MongoDB Atlas Vector Search)
VECTOR_STORE_TYPE=local
LOCAL_VECTOR_STORE_PATH=./data/vector_store
MONGODB_VECTOR_INDEX_NAME=rag_vector_index

# File Upload and Processing
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K_RESULTS=5

# CORS Configuration (comma-separated origins)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
